# 复制为 .env 后填写实际值。.env 已被 .gitignore 排除。
#
# 不填 API Key 时系统仍可运行：把 GOVFIN_LLM_PROVIDER 设为 offline
# 走确定性离线后端，完整管道与全部暴力测试都能跑通。

# ---- 主 LLM（本体演化提案、跨文档推理、审计报告生成） ----
GOVFIN_LLM_PROVIDER=deepseek
GOVFIN_LLM_API_KEY=
GOVFIN_LLM_BASE_URL=https://api.deepseek.com/v1
GOVFIN_LLM_MODEL=deepseek-chat
GOVFIN_LLM_TEMPERATURE=0.0
GOVFIN_LLM_TIMEOUT=90

# 也支持任何 OpenAI 兼容端点（provider 填 deepseek，改 base_url 即可）：
#   DashScope/通义千问  https://dashscope.aliyuncs.com/compatible-mode/v1
#   智谱 GLM            https://open.bigmodel.cn/api/paas/v4
#   ModelScope          https://api-inference.modelscope.cn/v1
#   本地 vLLM           http://localhost:8000/v1

# ---- 图存储 ----
GOVFIN_GRAPH_DB=data/govfin_graph.db

# ---- 可选：多模态 OCR 走视觉大模型 ----
GOVFIN_VLM_API_KEY=
GOVFIN_VLM_MODEL=qwen-vl-max
GOVFIN_VLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---- Nexent 集成（本机部署的定位与凭据） ----
# 租户账号。第一次跑 provision_tenant.py 时**随机生成并写入 .env**，
# 源码里不保存任何可用的凭据。
NEXENT_TENANT_EMAIL=
NEXENT_TENANT_PASSWORD=

# 平台超管。部署 Nexent 时自动创建，密码打印在它的部署日志里；
# 也可以在此显式填写。不填时脚本会去日志里找。
NEXENT_SUPERADMIN_EMAIL=
NEXENT_SUPERADMIN_PASSWORD=

# Nexent 源码目录。不填则按顺序找：与项目同级的 nexent_src/ → 项目内的 nexent_src/
# 路径不写死在代码里——那样既是泄露开发机的目录结构，别人也用不了。
NEXENT_SRC=
