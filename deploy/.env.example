# govfin-decision-agent 部署配置
#
# 复制为 .env 后填入实际值。.env 已在 .gitignore 里，不会被提交。
#   cp deploy/.env.example deploy/.env
#
# 所有项都有默认值，**全部留空也能跑起来**——只是本体演化会走纯符号路径。

# ---------------------------------------------------------------- LLM 通道
# 留空 GOVFIN_LLM_API_KEY 即进入离线模式：本体演化仍可运行（别名学习 +
# n-gram 聚类 + 符号对齐），但不再有 LLM 语义补全提案。
# 这是设计内的降级路径，不是故障态；决策与推理完全不依赖 LLM。
GOVFIN_LLM_PROVIDER=deepseek
GOVFIN_LLM_API_KEY=
GOVFIN_LLM_BASE_URL=https://api.deepseek.com/v1
GOVFIN_LLM_MODEL=deepseek-chat
GOVFIN_LLM_TEMPERATURE=0.0
GOVFIN_LLM_TIMEOUT=60.0
GOVFIN_LLM_MAX_RETRIES=3
# 熔断器：连续失败 N 次后打开，冷却 M 秒后半开探测。
# LLM 抖动不该拖垮整个服务——熔断期间自动退回符号路径。
GOVFIN_LLM_CIRCUIT_THRESHOLD=6
GOVFIN_LLM_CIRCUIT_COOLDOWN=30.0

# ---------------------------------------------------------------- 图与数据
GOVFIN_DATA_DIR=./data
GOVFIN_GRAPH_DB=./data/govfin_graph.db

# ---------------------------------------------------------------- 置信度模型
# 改这几项等于改判定口径。改之前先看 docs/confidence-model.md。
# 每条边按证据类别承担的惩罚系数：直接证据不罚，LLM 生成边罚得最重
GOVFIN_LAMBDA_DIRECT=1.0
GOVFIN_LAMBDA_DERIVED=1.6
GOVFIN_LAMBDA_LLM=2.6
# 非证据性跳数损耗，模拟语义漂移
GOVFIN_HOP_DECAY=0.95
# 瓶颈保护下限：最弱环节对整体的压制程度
GOVFIN_BOTTLENECK=0.25
# 全局决策阈值。注意：各约束还有自己的 accept_threshold，
# 多跳链的采纳判定以各自的阈值为准，这一个只作兜底。
GOVFIN_DECISION_THRESHOLD=0.55
# LLM 生成边的 Beta 先验，随历史验证反馈更新
GOVFIN_LLM_PRIOR_ALPHA=2.0
GOVFIN_LLM_PRIOR_BETA=2.0

# ---------------------------------------------------------------- 路径搜索边界
# 这四个是防止在稠密图上被单次查询拖死的安全阀。
GOVFIN_MAX_PATH_DEPTH=6
GOVFIN_MAX_PATHS=2000
GOVFIN_MAX_EXPANSIONS=200000
GOVFIN_QUERY_TIMEOUT=10.0
GOVFIN_SQLITE_BUSY_TIMEOUT=10000

# ---------------------------------------------------------------- 本体演化
# 把同一 UNK 提及的嵌入归并为一个候选概念的最小相似度
GOVFIN_CLUSTER_SIM=0.82
# 候选被提升为提案所需的最小出现频次（低于此值留在储备池继续观察）
GOVFIN_MIN_SUPPORT=3
# 提案自动通过 / 自动拒绝的置信度边界，中间地带转人工仲裁
GOVFIN_AUTO_ACCEPT=0.90
GOVFIN_AUTO_REJECT=0.35
GOVFIN_EMBED_DIM=256

# ---------------------------------------------------------------- 服务
GOVFIN_HOST=0.0.0.0
GOVFIN_MCP_PORT=8930
GOVFIN_A2A_PORT=8940
GOVFIN_PUBLIC_BASE_URL=http://localhost:8940
TZ=Asia/Shanghai
